{
  "name": "fe-ninja-tools",
  "displayName": "Build Compare Tools",
  "description": "Azure DevOps build comparison and analysis tools",
  "version": "2.0.3",
  "publisher": "matancohenmsft",
  "license": "MIT",
  "icon": "media/logo2.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matanelcohen/vscode-ado-build-compare.git"
  },
  "bugs": {
    "url": "https://github.com/matanelcohen/vscode-ado-build-compare/issues"
  },
  "homepage": "https://github.com/matanelcohen/vscode-ado-build-compare#readme",
  "keywords": [
    "azure-devops",
    "ado",
    "build",
    "pipeline",
    "comparison",
    "git",
    "deployment",
    "ci-cd"
  ],
  "sideEffects": false,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:fe-ninja-tools.showPipelines",
    "onView:build-compare-view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fe-ninja-tools.showPipelines",
        "title": "Open Comparison Workspace",
        "category": "Build Compare Tools",
        "icon": "$(compare-changes)"
      },
      {
        "command": "fe-ninja-tools.refresh",
        "title": "Refresh",
        "category": "Build Compare Tools",
        "icon": "$(refresh)"
      },
      {
        "command": "fe-ninja-tools.openSettings",
        "title": "Open Build Compare Tools Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fe-ninja-tools.configureTeams",
        "title": "Configure Teams Workflow",
        "category": "Build Compare Tools",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "fe-ninja-tools.setupProfile",
        "title": "Add Pipeline Profile",
        "category": "Build Compare Tools",
        "icon": "$(add)"
      },
      {
        "command": "fe-ninja-tools.switchProfile",
        "title": "Switch Pipeline Profile",
        "category": "Build Compare Tools",
        "icon": "$(list-selection)"
      },
      {
        "command": "fe-ninja-tools.deleteProfile",
        "title": "Delete Pipeline Profile",
        "category": "Build Compare Tools",
        "icon": "$(trash)"
      },
      {
        "command": "fe-ninja-tools.editProfile",
        "title": "Edit Pipeline Profile",
        "category": "Build Compare Tools",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "build-compare-tools",
          "title": "Build Compare Tools",
          "icon": "media/logo2.png"
        }
      ]
    },
    "views": {
      "build-compare-tools": [
        {
          "id": "build-compare-view",
          "name": "Release Dashboard",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "build-compare-view",
        "contents": "Connect Azure DevOps to compare releases, assess deployment risk, and share results with Teams.\n[Start guided setup](command:fe-ninja-tools.setupProfile)",
        "when": "!buildCompareTools.hasProfile"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "true",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "view == build-compare-view && buildCompareTools.hasProfile",
          "group": "navigation@1"
        },
        {
          "command": "fe-ninja-tools.refresh",
          "when": "view == build-compare-view && buildCompareTools.hasProfile",
          "group": "navigation@2"
        },
        {
          "command": "fe-ninja-tools.setupProfile",
          "when": "view == build-compare-view",
          "group": "navigation@3"
        },
        {
          "command": "fe-ninja-tools.openSettings",
          "when": "view == build-compare-view",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Build Compare Tools",
      "properties": {
        "buildCompareTools.organizationUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization URL (e.g., https://dev.azure.com/yourorg)."
        },
        "buildCompareTools.projectName": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps project name."
        },
        "buildCompareTools.pipelineDefinitionId": {
          "type": "number",
          "default": 0,
          "description": "The definition ID of the Azure Pipeline to monitor."
        },
        "buildCompareTools.targetStageName": {
          "type": "string",
          "default": "",
          "description": "The name of the target deployment stage in the pipeline."
        },
        "buildCompareTools.repositoryId": {
          "type": "string",
          "default": "",
          "description": "The ID or name of the repository associated with the pipeline."
        },
        "buildCompareTools.relevantPathFilter": {
          "type": "string",
          "default": "",
          "description": "Optional path filter to consider commits relevant (e.g., /src/frontend). Leave empty to include all."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile-production",
    "compile": "npm run compile-extension && npm run compile-webview",
    "compile-extension": "webpack --mode development",
    "compile-webview": "webpack --config webpack.webview.config.js --mode development",
    "compile-production": "npm run compile-extension-production && npm run compile-webview-production",
    "compile-extension-production": "webpack --mode production",
    "compile-webview-production": "webpack --config webpack.webview.config.js --mode production",
    "compile-watch": "npm run compile-extension-watch",
    "compile-extension-watch": "webpack --mode development --watch",
    "compile-webview-watch": "webpack --config webpack.webview.config.js --mode development --watch",
    "package": "vsce package --no-dependencies",
    "analyze-bundle": "webpack-bundle-analyzer out/extension.js",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "lint:ci": "eslint src --ext ts,tsx --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-integration.ts",
    "check": "npm run test && npm run lint:ci && npx tsc --noEmit && npm run compile-production"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ts-loader": "^9.5.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "webpack": "^5.100.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.63.0",
    "@fluentui/react-icons": "^2.0.247",
    "axios": "^1.6.0",
    "azure-devops-node-api": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.25.2",
    "react-syntax-highlighter": "^15.6.1"
  }
}
