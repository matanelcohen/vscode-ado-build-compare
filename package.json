{
  "name": "fe-ninja-tools",
  "displayName": "Release Lens for Azure DevOps",
  "description": "See what changed, assess deployment risk, and publish release intelligence from Azure DevOps.",
  "version": "3.5.0",
  "publisher": "matancohenmsft",
  "license": "MIT",
  "icon": "media/releaselens.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matanelcohen/vscode-ado-build-compare.git"
  },
  "bugs": {
    "url": "https://github.com/matanelcohen/vscode-ado-build-compare/issues"
  },
  "homepage": "https://github.com/matanelcohen/vscode-ado-build-compare#readme",
  "keywords": [
    "azure-devops",
    "ado",
    "build",
    "pipeline",
    "comparison",
    "git",
    "deployment",
    "ci-cd",
    "release-notes",
    "release-management",
    "devops",
    "teams",
    "copilot"
  ],
  "sideEffects": false,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:fe-ninja-tools.showPipelines",
    "onView:build-compare-view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fe-ninja-tools.showPipelines",
        "title": "Open Release Workspace",
        "category": "Release Lens",
        "icon": "$(compare-changes)"
      },
      {
        "command": "fe-ninja-tools.openDemo",
        "title": "Explore Sample Release",
        "category": "Release Lens",
        "icon": "$(preview)"
      },
      {
        "command": "fe-ninja-tools.refresh",
        "title": "Refresh",
        "category": "Release Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "fe-ninja-tools.openSettings",
        "title": "Open Release Lens Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fe-ninja-tools.configureTeams",
        "title": "Configure Teams Workflow",
        "category": "Release Lens",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "fe-ninja-tools.setupProfile",
        "title": "Add Pipeline Profile",
        "category": "Release Lens",
        "icon": "$(add)"
      },
      {
        "command": "fe-ninja-tools.switchProfile",
        "title": "Switch Pipeline Profile",
        "category": "Release Lens",
        "icon": "$(list-selection)"
      },
      {
        "command": "fe-ninja-tools.deleteProfile",
        "title": "Delete Pipeline Profile",
        "category": "Release Lens",
        "icon": "$(trash)"
      },
      {
        "command": "fe-ninja-tools.editProfile",
        "title": "Edit Pipeline Profile",
        "category": "Release Lens",
        "icon": "$(edit)"
      },
      {
        "command": "fe-ninja-tools.sendFeedback",
        "title": "Send Feedback",
        "category": "Release Lens",
        "icon": "$(feedback)"
      },
      {
        "command": "fe-ninja-tools.openPrivacy",
        "title": "View Privacy & Security",
        "category": "Release Lens",
        "icon": "$(shield)"
      },
      {
        "command": "fe-ninja-tools.manageProfiles",
        "title": "Import or Export Pipeline Profiles",
        "category": "Release Lens",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fe-ninja-tools.copyDiagnostics",
        "title": "Copy Safe Diagnostics",
        "category": "Release Lens",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "build-compare-tools",
          "title": "Release Lens",
          "icon": "media/releaselens-activity.svg"
        }
      ]
    },
    "views": {
      "build-compare-tools": [
        {
          "id": "build-compare-view",
          "name": "Release Dashboard",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "build-compare-view",
        "contents": "Understand a release before it ships—changes, contributors, risk, and Teams-ready notes.\n[Explore sample release](command:fe-ninja-tools.openDemo)\n[Connect Azure DevOps](command:fe-ninja-tools.setupProfile)",
        "when": "!buildCompareTools.hasProfile"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "true"
        }
      ],
      "view/item/context": [
        {
          "command": "fe-ninja-tools.sendFeedback",
          "when": "view == build-compare-view",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "true",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "fe-ninja-tools.showPipelines",
          "when": "view == build-compare-view && buildCompareTools.hasProfile",
          "group": "navigation@1"
        },
        {
          "command": "fe-ninja-tools.refresh",
          "when": "view == build-compare-view && buildCompareTools.hasProfile",
          "group": "navigation@2"
        },
        {
          "command": "fe-ninja-tools.setupProfile",
          "when": "view == build-compare-view",
          "group": "navigation@3"
        },
        {
          "command": "fe-ninja-tools.openSettings",
          "when": "view == build-compare-view",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Release Lens",
      "properties": {
        "buildCompareTools.organizationUrl": {
          "type": "string",
          "default": "",
          "description": "Legacy profile migration: Azure DevOps organization URL."
        },
        "buildCompareTools.projectName": {
          "type": "string",
          "default": "",
          "description": "Legacy profile migration: Azure DevOps project name."
        },
        "buildCompareTools.pipelineDefinitionId": {
          "type": "number",
          "default": 0,
          "description": "Legacy profile migration: Azure Pipeline definition ID."
        },
        "buildCompareTools.targetStageName": {
          "type": "string",
          "default": "",
          "description": "Legacy profile migration: target deployment stage."
        },
        "buildCompareTools.repositoryId": {
          "type": "string",
          "default": "",
          "description": "Legacy profile migration: repository ID or name."
        },
        "buildCompareTools.relevantPathFilter": {
          "type": "string",
          "default": "",
          "description": "Legacy profile migration: optional relevant path filters."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "releaselens.getStarted",
        "title": "Get started with Release Lens",
        "description": "Reach your first release insight in under a minute.",
        "steps": [
          {
            "id": "tryDemo",
            "title": "Explore a sample release",
            "description": "See risk, hotspots, pull requests, and share-ready output without signing in.\n[Open sample](command:fe-ninja-tools.openDemo)"
          },
          {
            "id": "connectAdo",
            "title": "Connect Azure DevOps",
            "description": "Guided discovery finds your project, repository, pipeline, and deployment stage.\n[Start setup](command:fe-ninja-tools.setupProfile)"
          },
          {
            "id": "compare",
            "title": "Review a real release",
            "description": "Compare builds and inspect exactly what changed.\n[Open workspace](command:fe-ninja-tools.showPipelines)"
          },
          {
            "id": "share",
            "title": "Share release intelligence",
            "description": "Configure a Teams Workflow and publish an Adaptive Card.\n[Configure Teams](command:fe-ninja-tools.configureTeams)"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile-production",
    "compile": "npm run compile-extension && npm run compile-webview",
    "compile-extension": "webpack --mode development",
    "compile-webview": "webpack --config webpack.webview.config.js --mode development",
    "compile-production": "npm run compile-extension-production && npm run compile-webview-production",
    "compile-extension-production": "webpack --mode production",
    "compile-webview-production": "webpack --config webpack.webview.config.js --mode production",
    "compile-watch": "npm run compile-extension-watch",
    "compile-extension-watch": "webpack --mode development --watch",
    "compile-webview-watch": "webpack --config webpack.webview.config.js --mode development --watch",
    "package": "vsce package --no-dependencies",
    "build:demo": "webpack --config webpack.demo.config.js --mode production && node scripts/copy-demo-assets.js",
    "build:demo-dev": "webpack --config webpack.demo.config.js --mode development && node scripts/copy-demo-assets.js",
    "analyze-bundle": "webpack-bundle-analyzer out/extension.js",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "lint:ci": "eslint src --ext ts,tsx --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-integration.ts",
    "check": "npm run test && npm run lint:ci && npx tsc --noEmit && npm run compile-production"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ts-loader": "^9.5.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "webpack": "^5.100.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.63.0",
    "@fluentui/react-icons": "^2.0.247",
    "axios": "^1.6.0",
    "azure-devops-node-api": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
